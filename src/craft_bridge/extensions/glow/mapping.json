{
  "format": "craftbridge.mappings",
  "version": 2,
  "name": "bridge-glow",
  "plugins": [
    {
      "api": 1,
      "id": "org.craftbridge.glow",
      "name": "Bridge Glow (Approximate)",
      "category": "Craft Bridge",
      "version": "0.1.0",
      "author": "Craft Preset Bridge contributors",
      "description": "Original multiscale bloom renderer. Partial PEDG transfer; not Deep Glow render equivalence. No automatic gamma or proprietary runtime.",
      "params": [
        {
          "id": "radius",
          "name": "Radius (approximate profile)",
          "type": "slider",
          "default": 100.0,
          "min": 0,
          "max": 2000
        },
        {
          "id": "exposure",
          "name": "Exposure multiplier",
          "type": "slider",
          "default": 1.0,
          "min": 0,
          "max": 10000
        },
        {
          "id": "threshold",
          "name": "Threshold (%)",
          "type": "slider",
          "default": 50.0,
          "min": 0,
          "max": 100000
        },
        {
          "id": "threshold_smooth",
          "name": "Threshold Smooth (%)",
          "type": "slider",
          "default": 50.0,
          "min": 0,
          "max": 100
        },
        {
          "id": "blend",
          "name": "Blend Mode",
          "type": "popup",
          "default": 0,
          "options": [
            "Screen",
            "Add"
          ]
        },
        {
          "id": "aspect",
          "name": "Aspect Ratio",
          "type": "slider",
          "default": 1.0,
          "min": 0,
          "max": 2
        },
        {
          "id": "tint_enabled",
          "name": "Tint Enabled",
          "type": "checkbox",
          "default": false
        },
        {
          "id": "tint",
          "name": "Tint Color",
          "type": "color",
          "default": [
            1.0,
            0.0,
            0.0,
            1.0
          ]
        },
        {
          "id": "tint_mode",
          "name": "Tint Mode",
          "type": "popup",
          "default": 0,
          "options": [
            "Standard",
            "Overlay (W3C)",
            "Soft Light (W3C)"
          ]
        },
        {
          "id": "tint_mix",
          "name": "Tint Mix (%)",
          "type": "slider",
          "default": 100.0,
          "min": 0,
          "max": 100
        },
        {
          "id": "view",
          "name": "View",
          "type": "popup",
          "default": 1,
          "options": [
            "Glow Input",
            "Final Render"
          ]
        },
        {
          "id": "source_opacity",
          "name": "Source Opacity (%)",
          "type": "slider",
          "default": 100.0,
          "min": 0,
          "max": 100
        },
        {
          "id": "unmult",
          "name": "Generate Alpha (approximate)",
          "type": "checkbox",
          "default": true
        }
      ]
    }
  ],
  "mappings": [
    {
      "source": "PEDG",
      "source_format": "ffx",
      "target": "effectcraft",
      "effect": "org.craftbridge.glow",
      "params": {
        "PEDG-0001": {
          "target": "radius",
          "kind": "Float"
        },
        "PEDG-0002": {
          "target": "exposure",
          "kind": "Float"
        },
        "PEDG-0004": {
          "target": "threshold",
          "kind": "Float"
        },
        "PEDG-0005": {
          "target": "threshold_smooth",
          "kind": "Float"
        },
        "PEDG-0008": {
          "target": "blend",
          "kind": "Choice",
          "operation": "enum_map",
          "choices": {
            "1": 0,
            "2": 1
          }
        },
        "PEDG-0010": {
          "target": "aspect",
          "kind": "Float"
        },
        "PEDG-0037": {
          "target": "tint_enabled",
          "kind": "Bool"
        },
        "PEDG-0038": {
          "target": "tint",
          "kind": "Color",
          "operation": "argb255_to_rgba"
        },
        "PEDG-0039": {
          "target": "tint_mode",
          "kind": "Choice",
          "operation": "enum_map",
          "choices": {
            "1": 0,
            "2": 1,
            "3": 2
          }
        },
        "PEDG-0041": {
          "target": "tint_mix",
          "kind": "Float"
        },
        "PEDG-0023": {
          "target": "view",
          "kind": "Choice",
          "operation": "enum_map",
          "choices": {
            "1": 0,
            "2": 1
          }
        },
        "PEDG-0024": {
          "target": "source_opacity",
          "kind": "Float"
        },
        "PEDG-0025": {
          "target": "unmult",
          "kind": "Bool"
        }
      },
      "evidence": "Exact PEDG parT IDs/kinds from 23 private real snapshots; manufacturer Deep Glow v1.4.6 manual bundled in official v1.5.7 archive (previous-versions); original renderer definitions documented in ADR 008.",
      "validation": "real-source-descriptors; approximate-renderer; Adobe-visual-equivalence-unverified",
      "target_commit": "e38a92e792c07f1c57c5dcfcab37d91932b9e2b8",
      "limitations": [
        "Renderer próprio aproximado: kernel multiescala, limiar suave e alpha não reproduzem o algoritmo proprietário PEDG. Radius conserva o controle, sem prova de equivalência espacial.",
        "A API v1 não fornece o espaço de cor do projeto: Auto Detect Gamma/Gamma Correction não são transferidos. O renderer calcula no espaço dos pixels recebidos.",
        "Spread, Smooth Blending, aberração cromática, qualidade/downsample/steps/iterations, dither, máscaras e recorte/expansão de bordas não são reproduzidos. O buffer mantém seu tamanho.",
        "Overlay/Soft Light usam as fórmulas W3C para SDR; isso não comprova a implementação Adobe, especialmente para HDR. Unmult usa alpha derivado do maior componente absoluto."
      ]
    }
  ]
}

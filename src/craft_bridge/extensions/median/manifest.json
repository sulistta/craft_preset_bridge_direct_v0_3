{
  "api": 1,
  "id": "org.craftbridge.median",
  "name": "Bridge Median (Approximate)",
  "category": "Craft Bridge",
  "version": "0.1.0",
  "author": "Craft Preset Bridge contributors",
  "description": "Original oriented rectangular neighborhood filtering with four channel modes and bounded sampling. Geometry, fractional response, color/alpha and compositing are not certified against BCC; masks remain unresolved.",
  "params": [
    {
      "id": "mode",
      "name": "Mode",
      "type": "popup",
      "default": 2,
      "options": [
        "Selected Channel Only",
        "Pixel Selected by Channel",
        "A R G B Separately",
        "Most Common Pixel"
      ]
    },
    {
      "id": "channel",
      "name": "Channel",
      "type": "popup",
      "default": 0,
      "options": [
        "Luminance",
        "Lightness",
        "Brightness",
        "Hue",
        "Saturation",
        "Alpha",
        "Red",
        "Green",
        "Blue"
      ]
    },
    {
      "id": "preserve_alpha",
      "name": "Preserve Alpha",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "length",
      "name": "Raw Median Length",
      "type": "slider",
      "default": 5,
      "min": 0,
      "max": 512
    },
    {
      "id": "width",
      "name": "Raw Median Width",
      "type": "slider",
      "default": 5,
      "min": 0,
      "max": 512
    },
    {
      "id": "angle",
      "name": "Median Angle",
      "type": "slider",
      "default": 0,
      "min": -36000,
      "max": 36000
    },
    {
      "id": "fractional",
      "name": "Enable Fractional Radius",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "level",
      "name": "Raw Median Level",
      "type": "slider",
      "default": 100,
      "min": 0,
      "max": 100
    },
    {
      "id": "softness",
      "name": "Raw Softness",
      "type": "slider",
      "default": 0,
      "min": 0,
      "max": 100
    },
    {
      "id": "mix",
      "name": "Raw Mix with Original",
      "type": "slider",
      "default": 0,
      "min": 0,
      "max": 100
    }
  ]
}

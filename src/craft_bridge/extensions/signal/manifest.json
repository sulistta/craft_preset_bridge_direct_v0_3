      "name": "Thick distortion",
      "type": "slider",
      "default": 0,
      "min": -100,
      "max": 100
    },
    {
      "id": "fine",
      "name": "Fine distotrion",
      "type": "slider",
      "default": 0,
      "min": -100,
      "max": 100
    },
    {
      "id": "distortion_speed",
      "name": "Distortion speed",
      "type": "slider",
      "default": 0,

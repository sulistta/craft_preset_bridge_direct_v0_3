    {
      "id": "sharpen_enable",
      "name": "Sharpen On/Off",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "scan_blur",
      "name": "Scanlines blur",
      "type": "slider",
      "default": 1.5,
      "min": 0,
      "max": 100

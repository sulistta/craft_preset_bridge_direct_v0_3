{
  "api": 2,
  "bridge_host_revision": 1,
  "id": "org.craftbridge.signal",
  "name": "Bridge Signal (Approximate)",
  "category": "Craft Bridge",
  "version": "0.1.0",
  "author": "Craft Preset Bridge contributors",
  "description": "Original bounded luminance/chrominance modulation and decoding. Independent calibration; no Zaebects Signal equivalence. Requires experimental Bridge API 2 host.",
  "params": [
    {
      "id": "seed",
      "name": "Random seed",
      "type": "slider",
      "default": 1,
      "min": 0,
      "max": 1000000000.0
    },
    {
      "id": "strength",
      "name": "Signal strength",
      "type": "slider",
      "default": 40,
      "min": 0,
      "max": 100
    },
    {
      "id": "amplification",
      "name": "Signal amplification",
      "type": "slider",
      "default": 1,
      "min": 0,
      "max": 64
    },
    {
      "id": "cutoff",
      "name": "Cutoff filter",
      "type": "slider",
      "default": 88,
      "min": 0,
      "max": 100
    },
    {
      "id": "luma_noise",
      "name": "Luma noise",
      "type": "slider",
      "default": 1,
      "min": 0,
      "max": 100
    },
    {
      "id": "chroma_noise",
      "name": "Chroma noise",
      "type": "slider",
      "default": 1,
      "min": 0,
      "max": 100
    },
    {
      "id": "hue_noise",
      "name": "Hue Noise",
      "type": "slider",
      "default": 15,
      "min": 0,
      "max": 10000
    },
    {
      "id": "chroma_loss",
      "name": "Chroma loss",

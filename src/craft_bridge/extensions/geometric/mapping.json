{
  "format": "craftbridge.mappings",
  "version": 2,
  "name": "bridge-geometric-1",
  "plugins": [
    {
      "api": 4,
      "bridge_host_revision": 3,
      "id": "org.craftbridge.geometric",
      "name": "Bridge Geometric (Approximate)",
      "category": "Craft Bridge",
      "version": "0.1.0",
      "author": "Craft Preset Bridge contributors",
      "description": "Original bounded proximity-matching geometric painter. Not the proprietary Satori algorithm. Requires experimental API 4 host.",
      "params": [
        {
          "id": "keep",
          "name": "Keep Original Image",
          "type": "checkbox",
          "default": true
        },
        {
          "id": "skip",
          "name": "Skip Frame(s)",
          "type": "slider",
          "default": 0.0,
          "min": 0,
          "max": 1024
        },
        {
          "id": "shape",
          "name": "Shape type",
          "type": "popup",
          "default": 2,
          "options": [
            "Line",
            "Curve",
            "Triangle",
            "Square",
            "Circle",
            "Rectangle"
          ]
        },
        {
          "id": "count",
          "name": "Count",
          "type": "slider",
          "default": 1000.0,
          "min": 0,
          "max": 10000
        },
        {
          "id": "recursion",
          "name": "Recursion Steps",
          "type": "slider",
          "default": 1.0,
          "min": 0,
          "max": 16
        },
        {
          "id": "size",
          "name": "Size",
          "type": "slider",
          "default": 28.0,
          "min": 0,
          "max": 2048
        },
        {
          "id": "growth",
          "name": "Size Growth",
          "type": "slider",
          "default": 32.0,
          "min": 0,
          "max": 2048
        },
        {
          "id": "width",
          "name": "Line Width",
          "type": "slider",
          "default": 1.75,
          "min": 0,
          "max": 512
        },
        {
          "id": "fill",
          "name": "Fill",
          "type": "checkbox",
          "default": false
        },
        {
          "id": "opacity",
          "name": "Opacity",
          "type": "slider",
          "default": 100.0,
          "min": 0,
          "max": 100
        },
        {
          "id": "angle",
          "name": "Starting Angle",
          "type": "slider",
          "default": 228.0,
          "min": -1000000,
          "max": 1000000
        },
        {
          "id": "angle_random",
          "name": "Angle Randomization",
          "type": "slider",
          "default": 32.0,
          "min": 0,
          "max": 1000000
        },
        {
          "id": "angle_range",
          "name": "Angle Range",
          "type": "slider",
          "default": 150.0,
          "min": 0,
          "max": 1000000
        },
        {
          "id": "accuracy",
          "name": "Matching Accuracy",
          "type": "slider",
          "default": 95.0,
          "min": 0,
          "max": 100
        },
        {
          "id": "fade",
          "name": "Fade Type",
          "type": "popup",
          "default": 1,
          "options": [
            "None",
            "Fade out by size",
            "Fade in by size",
            "Fade out by recursion",
            "Fade in by recursion"
          ]
        },
        {
          "id": "fade_level",
          "name": "Fade Level",
          "type": "slider",
          "default": 40.0,
          "min": 0,
          "max": 100
        },
        {
          "id": "min_luma",
          "name": "Minimum Luminosity",
          "type": "slider",
          "default": 2.0,
          "min": 0,
          "max": 255
        },
        {
          "id": "max_luma",
          "name": "Maximum Luminosity",
          "type": "slider",
          "default": 255.0,
          "min": 0,
          "max": 255
        },
        {
          "id": "strategy",
          "name": "Starting Pos. Strategy",
          "type": "popup",
          "default": 1,
          "options": [
            "Random",
            "Stable Random",
            "Grid"
          ]
        },
        {
          "id": "grid_random",
          "name": "Grid Randomization",
          "type": "slider",
          "default": 0.0,
          "min": 0,
          "max": 100
        },
        {
          "id": "seed",
          "name": "Random Seed (Evolution)",
          "type": "slider",
          "default": 777.0,
          "min": -1000000000,
          "max": 1000000000
        }
      ],
      "temporal_inputs": [
        {
          "id": "held",
          "mode": "frame_hold",
          "parameter": "skip",
          "multiple": 1,
          "edge": "clamp"
        }
      ]
    }
  ],

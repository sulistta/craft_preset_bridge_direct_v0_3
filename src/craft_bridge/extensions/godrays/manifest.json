{
  "api": 2,
  "bridge_host_revision": 1,
  "id": "org.craftbridge.godrays",
  "name": "Bridge Godrays (Approximate)",
  "category": "Craft Bridge",
  "version": "0.1.0",
  "author": "Craft Preset Bridge contributors",
  "description": "Original radial/spin ray integration with explicit raw-coordinate and alpha models. No ProductionCrate code or assets. Experimental API2 host required.",
  "params": [
    {
      "id": "mode",
      "name": "Mode",
      "type": "popup",
      "default": 1,
      "options": [
        "Spin",
        "Zoom"
      ]
    },
    {
      "id": "position",
      "name": "Position (Raw)",
      "type": "point",
      "default": [
        0.0,
        0.0
      ]
    },
    {
      "id": "threshold_mode",
      "name": "Threshold Mode",
      "type": "popup",
      "default": 0,
      "options": [
        "Luma",
        "Chroma"
      ]
    },
    {
      "id": "threshold",
      "name": "Threshold (Raw)",
      "type": "slider",
      "default": 0.0,
      "min": 0,
      "max": 100
    },
    {
      "id": "smooth",
      "name": "Threshold Smooth (Raw)",
      "type": "slider",
      "default": 0.0,
      "min": 0,
      "max": 100
    },
    {
      "id": "length",

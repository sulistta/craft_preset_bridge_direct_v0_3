      "type": "popup",
      "default": 0,
      "options": [
        "Out",
        "In",
        "In & Out"
      ]
    },
    {
      "id": "chromatic",
      "name": "Chromatic Amount (Raw)",
      "type": "slider",
      "default": 0.0,
      "min": 0,
      "max": 100

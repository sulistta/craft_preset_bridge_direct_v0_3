    {
      "id": "top",
      "name": "Trim Top (Raw)",
      "type": "slider",
      "default": 0.0,
      "min": 0,
      "max": 8192
    },
    {
      "id": "right",
      "name": "Trim Right (Raw)",
      "type": "slider",
      "default": 0.0,
      "min": 0,
      "max": 8192
    },
    {
      "id": "bottom",

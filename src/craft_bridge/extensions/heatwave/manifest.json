{
  "api": 2,
  "bridge_host_revision": 1,
  "id": "org.craftbridge.heatwave",
  "name": "Bridge Heatwave (Approximate)",
  "category": "Craft Bridge",
  "version": "0.1.0",
  "author": "Craft Preset Bridge contributors",
  "description": "Original noise displacement, spatial blur and geometric/layer masks. Independent noise, geometry, alpha and raw slider calibration; no Universe equivalence. Requires experimental Bridge API 2 host.",
  "params": [
    {
      "id": "mask",
      "name": "Mask Layer",
      "type": "layer",
      "default": null
    },
    {
      "id": "maskSource",
      "name": "Mask source mode",
      "type": "popup",
      "default": 0,
      "options": [
        "Source",
        "Masks",
        "Effects & Masks"
      ]
    },
    {
      "id": "wave_type",
      "name": "Wave Type",
      "type": "popup",
      "default": 0,
      "options": [
        "Default",
        "Billowed",
        "Ridged"
      ]
    },
    {
      "id": "intensity",
      "name": "Heat Intensity",
      "type": "slider",
      "default": 25,
      "min": 0,
      "max": 100
    },
    {
      "id": "direction",
      "name": "Flow Direction (degrees)",
      "type": "slider",
      "default": 90,

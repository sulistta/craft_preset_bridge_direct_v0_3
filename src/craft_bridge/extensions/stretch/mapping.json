{
  "format": "craftbridge.mappings",
  "version": 2,
  "name": "bridge-stretch",
  "plugins": [
    {
      "api": 1,
      "id": "org.craftbridge.stretch",
      "name": "Bridge Stretch (Approximate)",
      "category": "Craft Bridge",
      "version": "0.1.0",

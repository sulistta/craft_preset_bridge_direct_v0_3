          "name": "Distribution Range (frame ratio)",
          "type": "slider",
          "default": 2,
          "min": 0,
          "max": 10000
        },
        {
          "id": "shift_phase",
          "name": "Image Shift Phase (degrees)",
          "type": "slider",
          "default": 0,
          "min": -1000000.0,
          "max": 1000000.0,
          "sliderMin": -360,
          "sliderMax": 360
        },
        {
          "id": "sync",
          "name": "Image Shift Phase Sync",
          "type": "checkbox",
          "default": true
        },
        {
          "id": "shading",
          "name": "Shading",
          "type": "popup",
          "default": 0,
          "options": [
            "None",
            "Sine Wave",
            "Triangle Wave",
            "Linear Ramp Up",
            "Linear Ramp Down",
            "Line"
          ]
        },
        {
          "id": "shade_size",
          "name": "Shading Interval Size (original calibration)",
          "type": "slider",
          "default": 10,
          "min": 0.001,
          "max": 10000
        },
        {
          "id": "shade_phase",
          "name": "Shading Interval Phase (degrees)",
          "type": "slider",
          "default": 0,
          "min": -1000000.0,
          "max": 1000000.0,
          "sliderMin": -360,
          "sliderMax": 360
        },
        {
          "id": "shade_channels",
          "name": "Shading Channels",
          "type": "popup",
          "default": 0,
          "options": [
            "Alpha",
            "RGB"
          ]
        },
        {
          "id": "shade_opacity",
          "name": "Shading Opacity (%)",
          "type": "slider",
          "default": 0,
          "min": 0,
          "max": 100
        },
        {
          "id": "edge",
          "name": "Edge Mode",
          "type": "popup",
          "default": 0,
          "options": [
            "Wrap",
            "Mirror",
            "Repeat Last",
            "Transparent"
          ]
        },
        {
          "id": "feather",
          "name": "Transparency Feather (original calibration)",
          "type": "slider",
          "default": 0,
          "min": 0,
          "max": 100
        }
      ]
    }

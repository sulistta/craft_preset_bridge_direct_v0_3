        {
          "id": "direction",
          "name": "Direction",
          "type": "popup",
          "default": 0,
          "options": [
            "Right",
            "Left",
            "Down",
            "Up"
          ]
        },
        {
          "id": "channels",
          "name": "Channels",
          "type": "popup",
          "default": 0,
          "options": [
            "Luma",
            "RGBA",
            "Red",
            "Green",
            "Blue",
            "Alpha",
            "Luma (no Alpha)",
            "RGB (no Alpha)"
          ]
        },
        {
          "id": "intensity",
          "name": "Intensity (%)",
          "type": "slider",
          "default": 100,
          "min": 0,
          "max": 100
        },
        {
          "id": "stretch",
          "name": "Pixel Stretch (original calibration)",
          "type": "slider",
          "default": 0,
          "min": 0,
          "max": 10000
        },
        {
          "id": "pixel_size",
          "name": "Pixel Size (original calibration)",
          "type": "slider",
          "default": 1,
          "min": 0.001,
          "max": 10000
        },
        {
          "id": "curve",
          "name": "Stretch Curve",
          "type": "popup",
          "default": 0,
          "options": [
            "Linear Ramp Up",
            "Linear Ramp Down",
            "Triangle Wave",
            "Sine Wave",
            "Exp Up",
            "Exp Down"
          ]
        },
        {
          "id": "curve_phase",
          "name": "Curve Phase (degrees)",
          "type": "slider",
          "default": 0,
          "min": -1000000.0,
          "max": 1000000.0,
          "sliderMin": -360,
          "sliderMax": 360
        },
        {
          "id": "smoothness",
          "name": "Curve Smoothness (original calibration)",
          "type": "slider",
          "default": 0,
          "min": 0,
          "max": 100
        },
        {
          "id": "start",
          "name": "Start Offset (%)",
          "type": "slider",
          "default": 0,
          "min": 0,
          "max": 100
        },
        {
          "id": "distribution",
          "name": "Distribution Mode",
          "type": "popup",
          "default": 0,
          "options": [
            "Constant",
            "Linear Ramp Up",
            "Linear Ramp Down"
          ]
        },
        {

  "mappings": [
    {
      "source_format": "ffx",
      "target": "effectcraft",
      "source": "OLM Directional Blur",
      "effect": "org.craftbridge.olmdirectional",
      "params": {
        "OLM Directional Blur-0017": {
          "target": "noise",
          "kind": "Layer",
          "operation": "explicit_layer_binding",
          "inactive_when": {

+#[test]
+fn source_mode_companion_uses_native_host_semantics() {
+    let p = load(COPY);
+    for mode in [0, 1, 2] {
+        let h = host();
+        let mut values = params(Some(12));
+        values.values.insert(effectcraft_effects::layer_source_id("source"), Value::Enum(mode));
+        run(&p, &values, Some(&h)).0.unwrap();
+        assert_eq!(*h.requested.lock().unwrap(), vec![(12, mode != 0)]);
+    }
+}
+
+#[test]
+fn invalid_host_buffers_fail_before_wasm() {
+    let p = load("unreachable");
+    for mode in 0..7 {
+        let mut h = host();
+        let image = h.image.as_mut().unwrap();
+        match mode {
+            0 => image.buf.img.width = 0,
+            1 => image.buf.img.data.clear(),
+            2 => image.buf.offset[0] = f64::NAN,
+            3 => image.buf.scale = 0.0,
+            4 => image.size[0] = f64::INFINITY,
+            5 => image.buf.img.data[0][0] = f32::NAN,
+            _ => {
+                image.buf.img.width = 65536;
+                image.buf.img.height = 65536;
+            }
+        }
+        let result = run(&p, &params(Some(6)), Some(&h));
+        assert!(result.0.is_err());
+        assert_eq!(result.1, vec![[0.8, 0.6, 0.2, 1.0]; 2]);
+    }
+}
+
+#[test]
+fn render_errors_never_publish_partial_pixels_and_recover() {
+    for tail in ["unreachable", "i32.const 7 return", "(loop $spin br $spin)", "local.get $px f32.const nan f32.store i32.const 0 return"] {
+        let body = format!("local.get $time f64.const 0.5 f64.gt if local.get $px f32.const 0.9 f32.store {tail} end {COPY}");
+        let p = load(&body);
+        let h = host();
+        let result = run(&p, &params(Some(1)), Some(&h));
+        assert!(result.0.is_err());
+        assert_eq!(result.1, vec![[0.8, 0.6, 0.2, 1.0]; 2]);
+        let values = params(Some(1));
+        let ctx = EffectCtx {
+            params: &values,
+            time: 0.0,
+            layer_size: [2.0, 1.0],
+            seed: 1,
+            adjustment: false,
+            env: EffectEnv { host: Some(&h), ..Default::default() },
+        };
+        let mut b = Buf { img: Image::filled(2, 1, [0.8; 4]), offset: [0.0; 2], scale: 1.0 };
+        let flat = effectcraft_effects::plugin::flatten(p.manifest(), &ctx, &b);
+        let par = PluginParams { manifest: p.manifest(), flat: &flat };
+        p.render_with_context(&mut PluginFrame { width: 2, height: 1, pixels: &mut b.img.data, scale: 1.0 }, &par, &ctx, b.offset).unwrap();
+        assert_eq!(b.img.data[0], [0.2, 0.3, 0.4, 0.5]);
+    }
+}
+
+#[test]
+fn bad_allocator_and_version_contracts_are_rejected() {
+    for ptr in ["65537", "-8", "131072"] {
+        let m = module("org.craftbridge.test.alloc", COPY).replace("(result i32) i32.const 65536)", &format!("(result i32) i32.const {ptr})"));
+        let p = WasmPlugin::new(m.as_bytes(), "original.wat").unwrap();
+        unchanged(run(&p, &params(Some(1)), Some(&host())), "unaligned or out-of-bounds");
+    }
+    let original = module("org.craftbridge.test.versions", "");
+    for (from, to) in [
+        ("\\\"api\\\":2", "\\\"api\\\":1"),
+        ("ec_render_v2", "ec_render"),
+        ("(param $nt i32)", "(param $nt f64)"),
+        ("\\\"default\\\":null", "\\\"default\\\":7"),
+    ] {
+        assert!(original.contains(from));
+        assert!(WasmPlugin::new(original.replace(from, to).as_bytes(), "original.wat").is_err());
+    }
+}
+
+#[test]
+fn layer_manifests_require_api_two_null_defaults_and_at_most_four_inputs() {
+    let p = load("");
+    let mut manifest = p.manifest().clone();
+    manifest.api = 1;
+    assert!(manifest.validate().unwrap_err().contains("API 2"));
+    manifest.api = 2;
+    let original = manifest.params[1].clone();
+    for i in 1..=4 {
+        let mut layer = original.clone();
+        layer.id = format!("source{i}");
+        manifest.params.push(layer);
+        if i < 4 {
+            manifest.validate().unwrap();
+        } else {
+            assert!(manifest.validate().unwrap_err().contains("four"));
+        }
+    }
+}
+
+#[test]
+fn four_inputs_preserve_slots_uids_and_image_pointers() {
+    let p = load("");
+    let mut manifest = p.manifest().clone();
+    let original = manifest.params[1].clone();
+    for i in 1..=3 {
+        let mut layer = original.clone();
+        layer.id = format!("source{i}");
+        manifest.params.push(layer);
+    }
+    let mut body = "local.get $nt i32.const 5 i32.ne if unreachable end\n".to_string();
+    for (entry, index) in [(1, 1), (2, 3), (3, 4), (4, 5)] {
+        let at = entry * 80;
+        body += &format!("local.get $table i32.load offset={at} i32.const {index} i32.ne if unreachable end\n");
+        body += &format!("local.get $table i32.load offset={} i32.const {entry} i32.ne if unreachable end\n", at + 4);
+        body += &format!("local.get $table i32.load offset={} f32.load f32.const 0.2 f32.ne if unreachable end\n", at + 16);
+    }
+    let raw = serde_json::to_string(&manifest).unwrap();
+    let p = WasmPlugin::new(module_with_manifest(&raw, &body).as_bytes(), "original-four-inputs.wat").unwrap();
+    let mut values = params(Some(1));
+    for i in 1..=3 {
+        values.values.insert(format!("source{i}"), Value::Layer(Some(i + 1)));
+    }
+    let h = host();
+    run(&p, &values, Some(&h)).0.unwrap();
+    assert_eq!(*h.requested.lock().unwrap(), vec![(1, false), (2, false), (3, false), (4, false)]);
+}
+
+#[test]
+fn flat_uid_tampering_fails_before_resolving_host() {
+    let p = load("unreachable");
+    let h = host();
+    let values = params(Some((1 << 53) + 17));
+    let ctx =
+        EffectCtx { params: &values, time: 0.0, layer_size: [2.0, 1.0], seed: 1, adjustment: false, env: EffectEnv { host: Some(&h), ..Default::default() } };
+    let b = Buf { img: Image::filled(2, 1, [0.8; 4]), offset: [0.0; 2], scale: 1.0 };
+    let baseline = effectcraft_effects::plugin::flatten(p.manifest(), &ctx, &b);
+    for half in [0.0, -1.0, 1.5, 4294967296.0] {
+        let mut flat = baseline.clone();
+        flat[1] = half;
+        let par = PluginParams { manifest: p.manifest(), flat: &flat };
+        let mut pixels = b.img.data.clone();
+        assert!(p.render_with_context(&mut PluginFrame { width: 2, height: 1, pixels: &mut pixels, scale: 1.0 }, &par, &ctx, b.offset).is_err());
+        assert_eq!(pixels, b.img.data);
+    }
+    assert!(h.requested.lock().unwrap().is_empty());
+}
+
+#[test]
+fn registered_effect_trampoline_uses_context_and_restores_on_failure() {
+    let spec = crate::load_wasm(module("org.craftbridge.test.registered", COPY).as_bytes(), "original.wat").unwrap();
+    assert_eq!(spec.params[1].default.kind_name(), "layer");
+    let values = params(Some(55));
+    let h = host();
+    let mut ctx =
+        EffectCtx { params: &values, time: 0.0, layer_size: [2.0, 1.0], seed: 1, adjustment: false, env: EffectEnv { host: Some(&h), ..Default::default() } };
+    let b = Buf { img: Image::filled(2, 1, [0.8; 4]), offset: [2.0, 3.0], scale: 0.5 };
+    assert_eq!((spec.render)(&ctx, b.clone()).img.data[0], [0.2, 0.3, 0.4, 0.5]);
+    ctx.env.host = None;
+    let output = (spec.render)(&ctx, b.clone());
+    assert_eq!(output.img, b.img);
+    assert_eq!(output.offset, b.offset);
+    assert_eq!(output.scale, b.scale);
+}
+
+#[test]
+fn concurrent_renders_use_independent_memory() {
+    let p = load(COPY);
+    std::thread::scope(|scope| {
+        let joins: Vec<_> = (1..=8)
+            .map(|i| {
+                let p = &p;
+                scope.spawn(move || {
+                    let mut h = host();
+                    h.image.as_mut().unwrap().buf.img.data.fill([i as f32 / 10.0; 4]);
+                    let (result, output) = run(p, &params(Some(i)), Some(&h));
+                    result.unwrap();
+                    assert_eq!(output, vec![[i as f32 / 10.0; 4]; 2]);
+                })
+            })
+            .collect();
+        for join in joins {
+            join.join().unwrap();
+        }
+    });
+}

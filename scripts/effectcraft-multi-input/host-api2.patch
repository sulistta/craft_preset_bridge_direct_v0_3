+//! Original experimental Bridge transport. This is not the upstream ABI.
+use super::{FUEL_BASE, FUEL_PER_PIXEL, PluginFrame, PluginParams, RenderFn, WasmPlugin, err};
+use effectcraft_effects::{EffectCtx, LayerPixels, plugin::{PluginParamKind, TemporalMode, TemporalEdge}};
+
+const MAX_IMAGE_PIXELS: usize = 8_388_608;
+const MAX_TOTAL_PIXELS: usize = 33_554_432;
+const DESCRIPTOR_BYTES: usize = 80;
+// Synchronous EffectHost callbacks can recursively evaluate preceding plug-ins.
+// Bound the whole API 4 call tree per render thread, not just each node.
+thread_local! { static TEMPORAL_TREE: std::cell::Cell<(usize,usize,bool)> = const { std::cell::Cell::new((0,0,false)) }; }
+struct TemporalBudget { committed: bool }
+impl TemporalBudget {
+    fn enter() -> Result<Self,String> {
+        TEMPORAL_TREE.with(|s| {
+            let (depth,count,failed) = s.get();
+            if depth >= 16 { s.set((depth,count,true)); return Err("temporal nesting budget exceeded".into()); }
+            s.set(if depth == 0 {(1,0,false)} else {(depth+1,count,failed)});
+            Ok(Self { committed:false })
+        })
+    }
+    fn claim(&self) -> Result<(),String> {
+        TEMPORAL_TREE.with(|s| {
+            let (depth,count,failed) = s.get();
+            if failed || count >= 64 { s.set((depth,count,true)); return Err("temporal tree request budget exceeded".into()); }
+            s.set((depth,count+1,false)); Ok(())
+        })
+    }
+    fn healthy(&self) -> Result<(),String> {
+        if TEMPORAL_TREE.with(|s|s.get().2) { Err("nested temporal sampling failed; no partial source substitution".into()) } else { Ok(()) }
+    }
+}
+impl Drop for TemporalBudget {
+    fn drop(&mut self) {
+        TEMPORAL_TREE.with(|s| { let (depth,count,failed)=s.get(); s.set((depth.saturating_sub(1),count,failed || !self.committed)); });
+    }
+}
+
+
+// Original bounded source sampling; every request uses preceding effects only.
+fn temporal_time(now:f64, value:f64, mode:TemporalMode, edge:TemporalEdge, multiple:u32, timing:[f64;4]) -> Result<f64,String> {
+    let [_,first,last,step] = timing;
+    let (lo,hi) = (first.min(last),first.max(last));
+    let at = match mode {
+        TemporalMode::FrameHold => {
+            if !value.is_finite() || value.fract() != 0. || !(0. ..=1024.).contains(&value) || multiple != 1 {
+                return Err("frame_hold needs an integer skipped-frame count in 0..1024".into());
+            }
+            if value == 0. { now } else {
+                // Anchor to the earliest local visible frame; never fabricate an FPS.
+                let n = ((now-lo)/step+1e-8).floor();
+                lo+(n/(value+1.)).floor()*(value+1.)*step
+            }
+        }
+        TemporalMode::SecondsOffset => {
+            if !value.is_finite() || value.abs()>1000. || !(1..=16).contains(&multiple) { return Err("seconds offset exceeds limit".into()); }
+            now+value*multiple as f64
+        }
+        TemporalMode::FramesOffset => {
+            if !value.is_finite() || value.abs()>10000. || !(1..=16).contains(&multiple) { return Err("frames offset exceeds limit".into()); }
+            now+value*step*multiple as f64
+        }
+    };
+    if !at.is_finite() || at.abs()>1e9 { return Err("temporal time exceeds limit".into()); }
+    let span=hi-lo;
+    Ok(if span == 0. {lo} else {match edge {
+        TemporalEdge::Clamp => at.clamp(lo,hi),
+        TemporalEdge::Wrap => {let period=span+step;let v=lo+(at-lo).rem_euclid(period);v.min(hi)},
+        TemporalEdge::Mirror => {let v=(at-lo).rem_euclid(2.*span);if v<=span {lo+v} else {hi-(v-span)}},
+    }})
+}
+
+fn geometry(width: u32, height: u32, len: usize, offset: [f64; 2], scale: f64, size: [f64; 2]) -> Result<(), String> {
+    let count = (width as usize).checked_mul(height as usize).ok_or("image size overflow")?;
+    if width == 0 || height == 0 || width > 65536 || height > 65536 || count != len || count > MAX_IMAGE_PIXELS {
+        return Err("invalid or oversized image dimensions".into());
+    }
+    if offset.iter().any(|v| !v.is_finite() || v.abs() > 1e9)
+        || size.iter().any(|v| !v.is_finite() || *v <= 0.0 || *v > 1e9)
+        || !scale.is_finite()
+        || !(1.0 / 65536.0..=16.0).contains(&scale)
+    {
+        return Err("invalid buffer geometry".into());
+    }
+    Ok(())
+}
+
+fn flat_uid(flat: &[f64]) -> Result<u64, String> {
+    if flat.len() != 2 || flat.iter().any(|v| !v.is_finite() || v.fract() != 0.0 || !(0.0..=u32::MAX as f64).contains(v)) {
+        return Err("Layer UID requires two exact unsigned 32-bit halves".into());
+    }
+    Ok((flat[0] as u64) | ((flat[1] as u64) << 32))
+}
+
+fn total_pixels(current: usize, extra: usize) -> Result<usize, String> {
+    let total = current.checked_add(extra).ok_or("pixel count overflow")?;
+    if total > MAX_TOTAL_PIXELS {
+        return Err("combined pixel budget exceeded".into());
+    }
+    Ok(total)
+}
+
+fn descriptor(
+    buf: &mut Vec<u8>,
+    index: u32,
+    uid: u64,
+    flags: u32,
+    pixels: usize,
+    width: u32,
+    height: u32,
+    offset: [f64; 2],
+    scale: f64,
+    size: [f64; 2],
+) -> Result<(), String> {
+    let pixels = u32::try_from(pixels).map_err(|_| "pixel pointer overflow")?;
+    for v in [index, uid as u32, (uid >> 32) as u32, flags, pixels, width, height, 0] {
+        buf.extend_from_slice(&v.to_le_bytes());
+    }
+    for v in [offset[0], offset[1], scale, size[0], size[1]] {
+        buf.extend_from_slice(&v.to_le_bytes());
+    }
+    buf.extend_from_slice(&0u64.to_le_bytes());
+    Ok(())
+}
+
+fn pixels(buf: &mut Vec<u8>, data: &[[f32; 4]]) {
+    for pixel in data {
+        for v in pixel {
+            buf.extend_from_slice(&v.to_le_bytes());
+        }
+    }
+}
+
+pub(super) fn render(plugin: &WasmPlugin, frame: &mut PluginFrame, params: &PluginParams, ctx: &EffectCtx, offset: [f64; 2]) -> Result<(), String> {
+    let mut temporal_budget = if plugin.manifest.api == 4 {Some(TemporalBudget::enter()?)} else {None};
+    if params.manifest != &plugin.manifest || params.flat.len() != plugin.manifest.flat_len() || params.flat.iter().any(|v| !v.is_finite()) {
+        return Err("parameters do not match the loaded manifest".into());
+    }
+    if !ctx.time.is_finite() || ctx.time.abs() > 1e9 {
+        return Err("invalid render time".into());
+    }
+    geometry(frame.width, frame.height, frame.pixels.len(), offset, frame.scale, ctx.layer_size)?;
+    if frame.pixels.iter().flatten().any(|v| !v.is_finite()) {
+        return Err("nonfinite main pixels".into());
+    }
+    let mut inputs: Vec<(u32, u64, Option<LayerPixels>, u32)> = Vec::new();
+    let mut slot = 0;
+    let mut pixel_count = frame.pixels.len();
+    for (index, p) in plugin.manifest.params.iter().enumerate() {
+        let end = slot + p.kind.width();
+        if matches!(p.kind, PluginParamKind::Layer { .. }) {
+            let uid = flat_uid(&params.flat[slot..end])?;
+            // Do not let a wrong native type silently become an unbound resource.
+            let native = match ctx.params.get(&p.id) {
+                Some(value) if value.kind_name() == "layer" && value.as_layer() != Some(0) => value.as_layer().unwrap_or(0),
+                _ => return Err(format!("Layer `{}` has an invalid or missing native value", p.id)),
+            };
+            if native != uid {
+                return Err("Layer UID disagrees with the native parameter".into());
+            }
+            let image = if uid == 0 {
+                None
+            } else {
+                if let Some(b) = &temporal_budget { b.claim()?; }
+                let image = ctx.layer_param(&p.id, false).ok_or_else(|| format!("Layer `{}` is bound but unavailable from the host", p.id))?;
+                if let Some(b) = &temporal_budget { b.healthy()?; }
+                geometry(image.buf.img.width, image.buf.img.height, image.buf.img.data.len(), image.buf.offset, image.buf.scale, image.size)?;
+                if image.buf.img.data.iter().flatten().any(|v| !v.is_finite()) {
+                    return Err("nonfinite resource pixels".into());
+                }
+                pixel_count = total_pixels(pixel_count, image.buf.img.data.len())?;
+                Some(image)
+            };
+            inputs.push((index as u32, uid, image, 2));
+        }
+        slot = end;
+    }
+    let timing = if plugin.manifest.api >= 3 {
+        let [first, last, step] = ctx.env.layer_frame_times.ok_or("API 3 requires actual layer frame times")?;
+        let fps = ctx.env.frame_rate;
+        if !fps.is_finite() || !(0.001..=1e6).contains(&fps)
+            || [first, last].iter().any(|v| !v.is_finite() || v.abs() > 1e9)
+            || !step.is_finite() || !(1e-9..=1e9).contains(&step)
+        { return Err("invalid layer timing context".into()); }
+        Some([fps, first, last, step])
+    } else { None };
+    let mut temporal_times = Vec::new();
+    if plugin.manifest.api == 4 {
+        let timing = timing.ok_or("API 4 requires actual layer timing")?;
+        let requests = plugin.manifest.temporal_inputs.as_ref().ok_or("missing temporal input declarations")?;
+        for (index, request) in requests.iter().enumerate() {
+            let value = params.f(&request.parameter);
+            let native = ctx.params.get(&request.parameter).ok_or("temporal parameter missing from context")?;
+            if native.kind_name() != "scalar" || native.as_f64() != value {
+                return Err("temporal parameter disagrees with native context".into());
+            }
+            let at = temporal_time(ctx.time, value, request.mode, request.edge, request.multiple, timing)?;
+            let host = ctx.env.host.ok_or("temporal source requires an EffectHost")?;
+            if let Some(b) = &temporal_budget { b.claim()?; }
+            let image = LayerPixels { buf:host.self_at(at, ctx.env.effect_index).ok_or("temporal source unavailable; no substitution")?, size:ctx.layer_size };
+            if let Some(b) = &temporal_budget { b.healthy()?; }
+            geometry(image.buf.img.width, image.buf.img.height, image.buf.img.data.len(), image.buf.offset, image.buf.scale, image.size)?;
+            if image.buf.img.data.iter().flatten().any(|v| !v.is_finite()) { return Err("nonfinite temporal pixels".into()); }
+            pixel_count = total_pixels(pixel_count, image.buf.img.data.len())?;
+            inputs.push((0x8000_0000 | index as u32, 0, Some(image), 4));
+            temporal_times.push(at);
+        }
+    }
+    let timing_bytes = if timing.is_some() {32} else {0};
+    let params_bytes = params.flat.len() * 8;
+    let table_bytes = (inputs.len() + 1) * DESCRIPTOR_BYTES;
+    let main_bytes = frame.pixels.len() * 16;
+    let total = params_bytes.checked_add(table_bytes).and_then(|n| n.checked_add(timing_bytes)).and_then(|n| n.checked_add(pixel_count * 16)).ok_or("allocation overflow")?;
+    if total > i32::MAX as usize {
+        return Err("frame too large for a 32-bit plug-in".into());
+    }
+    let mut inst = plugin.take()?;
+    inst.store.set_fuel(FUEL_BASE + FUEL_PER_PIXEL * pixel_count as u64).map_err(err)?;
+    let base = inst.alloc.call(&mut inst.store, total as i32).map_err(err)? as u32 as usize;
+    let allocation_end = base.checked_add(total).ok_or("allocation pointer overflow")?;
+    if !base.is_multiple_of(8) || allocation_end > inst.memory.data(&inst.store).len() {
+        return Err("ec_alloc returned an unaligned or out-of-bounds buffer".into());
+    }
+    let table_ptr = base + params_bytes;
+    let timing_ptr = table_ptr + table_bytes;
+    let main_ptr = timing_ptr + timing_bytes;
+    let mut buf = Vec::with_capacity(total);
+    for v in params.flat {
+        buf.extend_from_slice(&v.to_le_bytes());
+    }
+    descriptor(&mut buf, u32::MAX, 0, 1, main_ptr, frame.width, frame.height, offset, frame.scale, ctx.layer_size)?;
+    let mut image_ptr = main_ptr + main_bytes;
+    for (index, uid, image, flags) in &inputs {
+        if let Some(image) = image {
+            descriptor(&mut buf, *index, *uid, *flags, image_ptr, image.buf.img.width, image.buf.img.height, image.buf.offset, image.buf.scale, image.size)?;
+            if *flags == 4 {
+                let at = temporal_times[(*index & 0x7fff_ffff) as usize];
+                let end = buf.len(); buf[end-8..end].copy_from_slice(&at.to_le_bytes());
+            }
+            image_ptr += image.buf.img.data.len() * 16;
+        } else {
+            descriptor(&mut buf, *index, 0, 0, 0, 0, 0, [0.0; 2], 0.0, [0.0; 2])?;
+        }
+    }
+    if let Some(timing) = timing { for v in timing { buf.extend_from_slice(&v.to_le_bytes()); } }
+    pixels(&mut buf, frame.pixels);
+    for (_, _, image, _) in &inputs {
+        if let Some(image) = image {
+            pixels(&mut buf, &image.buf.img.data);
+        }
+    }
+    inst.memory.write(&mut inst.store, base, &buf).map_err(err)?;
+    let args = (main_ptr as i32, frame.width as i32, frame.height as i32,
+        base as i32, params.flat.len() as i32, ctx.time, frame.scale,
+        table_ptr as i32, (inputs.len() + 1) as i32);
+    let code = match &inst.render {
+        RenderFn::V2(render) => render.call(&mut inst.store, args),
+        RenderFn::V3(render) => render.call(&mut inst.store, (args.0,args.1,args.2,args.3,args.4,args.5,args.6,args.7,args.8,timing_ptr as i32)),
+        RenderFn::V4(render) => render.call(&mut inst.store, (args.0,args.1,args.2,args.3,args.4,args.5,args.6,args.7,args.8,timing_ptr as i32)),
+        _ => return Err("expected multi-input renderer".into()),
+    }.map_err(|e| format!("ec_render_v{} trapped: {e}", plugin.manifest.api))?;
+    if code != 0 {
+        return Err(format!("ec_render_v{} returned error {code}", plugin.manifest.api));
+    }
+    let start = main_ptr - base;
+    let output = &mut buf[start..start + main_bytes];
+    inst.memory.read(&inst.store, main_ptr, output).map_err(err)?;
+    // Validate the complete result before changing any of the caller's pixels.
+    if output.as_chunks::<4>().0.iter().any(|v| !f32::from_le_bytes(*v).is_finite()) {
+        return Err(format!("ec_render_v{} produced nonfinite pixels", plugin.manifest.api));
+    }
+    for (pixel, bytes) in frame.pixels.iter_mut().zip(output.as_chunks::<16>().0) {
+        for (v, bytes) in pixel.iter_mut().zip(bytes.as_chunks::<4>().0) {
+            *v = f32::from_le_bytes(*bytes);
+        }
+    }
+    plugin.give_back(inst);
+    if let Some(b) = &mut temporal_budget { b.committed = true; }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn resource_budget_and_overflow() {
+        assert_eq!(total_pixels(MAX_TOTAL_PIXELS - 2, 2).unwrap(), MAX_TOTAL_PIXELS);
+        assert!(total_pixels(MAX_TOTAL_PIXELS, 1).is_err());
+        assert!(total_pixels(usize::MAX, 1).is_err());
+    }
+    #[test]
+    fn invalid_uid_halves_are_not_coerced() {
+        for pair in [[-1.0, 0.0], [1.5, 0.0], [0.0, f64::NAN], [0.0, f64::INFINITY], [4294967296.0, 0.0]] {
+            assert!(flat_uid(&pair).is_err());
+        }
+        assert_eq!(flat_uid(&[u32::MAX as f64; 2]).unwrap(), u64::MAX);
+        assert_eq!(flat_uid(&[0.0; 2]).unwrap(), 0);
+        assert!(flat_uid(&[1.0]).is_err());
+    }
+}
+
+#[cfg(test)]
+mod temporal_budget_tests {
+    use super::TemporalBudget;
+    #[test]
+    fn tree_budget_and_failed_child_propagate_without_poisoning_next_root() {
+        let mut root=TemporalBudget::enter().unwrap();
+        for _ in 0..64 { root.claim().unwrap(); }
+        assert!(root.claim().is_err()); assert!(root.healthy().is_err());
+        root.committed=true;drop(root);
+        let next=TemporalBudget::enter().unwrap(); assert!(next.healthy().is_ok());
+        { let _child=TemporalBudget::enter().unwrap(); }
+        assert!(next.healthy().is_err());drop(next);
+        let mut fresh=TemporalBudget::enter().unwrap();fresh.claim().unwrap();fresh.committed=true;
+    }
+    #[test]
+    fn nesting_limit_is_global_to_the_tree() {
+        let mut guards=Vec::new();for _ in 0..16 { guards.push(TemporalBudget::enter().unwrap()); }
+        assert!(TemporalBudget::enter().is_err());
+        assert!(guards[0].healthy().is_err());
+        while let Some(mut g)=guards.pop() {g.committed=true;drop(g);}
+        let mut fresh=TemporalBudget::enter().unwrap();assert!(fresh.healthy().is_ok());fresh.committed=true;
+    }
+}

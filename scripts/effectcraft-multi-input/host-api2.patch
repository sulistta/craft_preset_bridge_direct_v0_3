+//! Original API 4 source-image checks, not plugin fixtures.
+use crate::{EffectPlugin, PluginFrame, PluginParams, wasm::WasmPlugin};
+use effectcraft_effects::{Buf,EffectCtx,EffectEnv,EffectHost,LayerPixels,Params};
+use effectcraft_effects::plugin::PluginManifest;
+use effectcraft_keyframe::Value;
+use effectcraft_raster::Image;
+use std::sync::Mutex;
+fn manifest(mode:&str,edge:&str)->String {
+    let (lo,hi)=if mode=="frame_hold" {(0,1024)} else {(-1000,1000)};
+    format!(r#"{{"api":4,"bridge_host_revision":3,"id":"org.bridge.test.temporal","name":"Original temporal source","category":"Bridge test","params":[{{"id":"step","name":"Step","type":"slider","default":0,"min":{lo},"max":{hi}}}],"temporal_inputs":[{{"id":"source","mode":"{mode}","parameter":"step","edge":"{edge}"}}]}}"#)
+}
+fn module(manifest:&str,body:&str)->String {
+    let escaped=manifest.replace('"',"\\\"");
+    format!(r#"(module (memory (export "memory") 2)
+     (data (i32.const 16) "{escaped}")
+     (func (export "ec_api_version") (result i32) i32.const 4)
+     (func (export "ec_manifest_ptr") (result i32) i32.const 16)
+     (func (export "ec_manifest_len") (result i32) i32.const {len})
+     (func (export "ec_alloc") (param i32) (result i32) i32.const 65536)
+     (func (export "ec_render_v4") (param $px i32) (param $w i32) (param $h i32)
+       (param $params i32) (param $np i32) (param $time f64) (param $scale f64)
+       (param $table i32) (param $nt i32) (param $timing i32) (result i32)
+       {body} i32.const 0))"#,len=manifest.len())
+}
+const READ:&str=r#"
+ local.get $nt i32.const 2 i32.ne if unreachable end
+ local.get $table i32.load offset=80 i32.const -2147483648 i32.ne if unreachable end
+ local.get $table i64.load offset=84 i64.eqz i32.eqz if unreachable end
+ local.get $table i32.load offset=92 i32.const 4 i32.ne if unreachable end
+ local.get $table i32.load offset=96 f32.load
+ local.get $table f64.load offset=152 f32.demote_f64 f32.ne if unreachable end
+ local.get $px local.get $table i32.load offset=96 f32.load f32.store
+"#;
+struct Host { requests:Mutex<Vec<(f64,usize)>>, available:bool, fail_nested:bool }
+impl EffectHost for Host {
+ fn layer(&self,_:u64,_:bool)->Option<LayerPixels>{None}
+ fn audio(&self,_:u64,_:f64,_:usize,_:u32)->Option<Vec<f32>>{None}
+ fn self_at(&self,time:f64,prefix:usize)->Option<Buf>{
+  self.requests.lock().unwrap().push((time,prefix));
+  if self.fail_nested {
+    let inner=WasmPlugin::new(module(&manifest("frame_hold","clamp"),READ).as_bytes(),"original-failed-child").unwrap();
+    let native=Params{values:[("step".into(),Value::Scalar(0.))].into()};
+    let ctx=EffectCtx{params:&native,time:f64::NAN,layer_size:[1.,1.],seed:0,adjustment:false,env:EffectEnv::default()};
+    let mut child=vec![[0.;4]];
+    assert!(inner.render_with_context(&mut PluginFrame{width:1,height:1,pixels:&mut child,scale:1.},
+      &PluginParams{manifest:inner.manifest(),flat:&[0.]},&ctx,[0.,0.]).is_err());
+  }
+  self.available.then(||Buf { img:Image::filled(1,1,[time as f32,0.,0.,1.]),offset:[-2.,3.],scale:0.5 })
+ }
+}
+fn run(mode:&str,edge:&str,value:f64,time:f64,times:[f64;3],available:bool,body:&str)->(Result<(),String>,Vec<[f32;4]>,Vec<(f64,usize)>) {
+ let plugin=WasmPlugin::new(module(&manifest(mode,edge),body).as_bytes(),"original-time-input").unwrap();
+ let native=Params{values:[("step".into(),Value::Scalar(value))].into()};
+ let host=Host{requests:Mutex::new(Vec::new()),available,fail_nested:false};
+ let ctx=EffectCtx{params:&native,time,layer_size:[8.,4.],seed:0,adjustment:false,
+ env:EffectEnv{host:Some(&host),effect_index:7,frame_rate:25.,layer_frame_times:Some(times),..Default::default()}};
+ let mut pixels=vec![[0.25,0.5,0.75,1.];2];let flat=[value];
+ let result=plugin.render_with_context(&mut PluginFrame{width:2,height:1,pixels:&mut pixels,scale:0.5},
+   &PluginParams{manifest:plugin.manifest(),flat:&flat},&ctx,[0.,0.]);
+ (result,pixels,host.requests.into_inner().unwrap())
+}
+#[test] fn held_source_uses_actual_frames_and_preceding_effects() {
+ let (r,p,requests)=run("frame_hold","clamp",2.,0.39,[0.2,1.2,0.04],true,READ);
+ assert!(r.is_ok(),"{r:?}");assert!((p[0][0]-0.32).abs()<1e-6);
+ assert!((requests[0].0-0.32).abs()<1e-12);assert_eq!(requests[0].1,7);
+}
+#[test] fn offset_requests_resolve_actual_images_not_time_only() {
+ for (mode,value,expected) in [("seconds_offset",-0.1,0.65),("frames_offset",-2.,0.67)] {
+  let (r,p,q)=run(mode,"clamp",value,0.75,[0.2,1.2,0.04],true,READ);
+  assert!(r.is_ok(),"{r:?}");assert!((p[0][0] as f64-expected).abs()<1e-6);
+  assert!((q[0].0-expected).abs()<1e-12);
+ }
+}
+#[test] fn clamp_wrap_mirror_and_reversed_bounds_have_known_values() {
+ for (edge,value,expected) in [("clamp",-0.8,0.2),("wrap",-0.8,0.99),("mirror",-0.8,0.45)] {
+  for times in [[0.2,1.2,0.04],[1.2,0.2,0.04]] {
+   let (r,p,_)=run("seconds_offset",edge,value,0.75,times,true,READ);
+   assert!(r.is_ok(),"{r:?}");assert!((p[0][0] as f64-expected).abs()<1e-6);
+  }
+ }
+}
+#[test] fn unavailable_image_and_invalid_integer_roll_back() {
+ for (value,available) in [(2.,false),(2.5,true),(-1.,true),(1025.,true)] {
+  let (r,p,_)=run("frame_hold","clamp",value,0.75,[0.2,1.2,0.04],available,READ);
+  assert!(r.is_err());assert_eq!(p,vec![[0.25,0.5,0.75,1.];2]);
+ }
+}
+#[test] fn wasm_trap_or_nonfinite_output_never_commits_partial_pixels() {
+ for body in ["local.get $px f32.const 99 f32.store unreachable","local.get $px f32.const nan f32.store"] {
+  let (r,p,_)=run("seconds_offset","clamp",0.,0.75,[0.2,1.2,0.04],true,body);
+  assert!(r.is_err());assert_eq!(p,vec![[0.25,0.5,0.75,1.];2]);
+ }
+}
+#[test] fn manifests_and_export_signatures_are_bounded() {
+ let valid=manifest("frame_hold","clamp");
+ let m:PluginManifest=serde_json::from_str(&valid).unwrap();assert!(m.validate().is_ok());
+ for bad in [valid.replace("\"api\":4","\"api\":3"),valid.replace("\"bridge_host_revision\":3","\"bridge_host_revision\":2"),
+  valid.replace("\"parameter\":\"step\"","\"parameter\":\"missing\""),valid.replace("\"max\":1024","\"max\":1025"),
+  valid.replace("\"edge\":\"clamp\"","\"edge\":\"clamp\",\"multiple\":2")] {
+   assert!(WasmPlugin::new(module(&bad,READ).as_bytes(),"bad-manifest").is_err());
+ }
+ let wrong=module(&valid,READ).replace("(param $timing i32)","(param $timing f64)");
+ assert!(WasmPlugin::new(wrong.as_bytes(),"wrong-signature").is_err());
+}
+
+#[test] fn a_failed_temporal_child_is_not_accepted_as_partial_source_pixels() {
+ let plugin=WasmPlugin::new(module(&manifest("frame_hold","clamp"),READ).as_bytes(),"original-parent").unwrap();
+ let native=Params{values:[("step".into(),Value::Scalar(2.))].into()};
+ let host=Host{requests:Mutex::new(Vec::new()),available:true,fail_nested:true};
+ let ctx=EffectCtx{params:&native,time:0.39,layer_size:[8.,4.],seed:0,adjustment:false,
+  env:EffectEnv{host:Some(&host),effect_index:7,frame_rate:25.,layer_frame_times:Some([0.2,1.2,0.04]),..Default::default()}};
+ let mut pixels=vec![[0.25,0.5,0.75,1.];2];
+ let result=plugin.render_with_context(&mut PluginFrame{width:2,height:1,pixels:&mut pixels,scale:0.5},
+  &PluginParams{manifest:plugin.manifest(),flat:&[2.]},&ctx,[0.,0.]);
+ assert!(result.is_err());assert_eq!(pixels,vec![[0.25,0.5,0.75,1.];2]);
+ // A failure in one render tree must not poison a subsequent independent render.
+ let (r,_,_)=run("frame_hold","clamp",2.,0.39,[0.2,1.2,0.04],true,READ);assert!(r.is_ok());
+}

+//! Original timing transport cases; no source plugin or private fixture.
+use crate::{EffectPlugin, PluginFrame, PluginParams, wasm::WasmPlugin};
+use effectcraft_effects::{EffectCtx, EffectEnv, Params};
+use effectcraft_keyframe::Value;
+fn module(body: &str) -> String {
+    let manifest = r#"{"api":3,"id":"org.bridge.test.timing","name":"Timing probe","category":"Bridge test","params":[{"id":"gain","name":"Gain","type":"slider","default":1}]}"#;
+    let escaped=manifest.replace('"',"\\\"");
+    format!(r#"(module
+        (memory (export "memory") 2)
+        (data (i32.const 16) "{escaped}")
+        (func (export "ec_api_version") (result i32) i32.const 3)
+        (func (export "ec_manifest_ptr") (result i32) i32.const 16)
+        (func (export "ec_manifest_len") (result i32) i32.const {len})
+        (func (export "ec_alloc") (param i32) (result i32) i32.const 65536)
+        (func (export "ec_render_v3") (param $px i32) (param $w i32) (param $h i32)
+         (param $params i32) (param $np i32) (param $time f64) (param $scale f64)
+         (param $table i32) (param $nt i32) (param $timing i32) (result i32)
+         {body} i32.const 0))"#,len=manifest.len())
+}
+const TIMING:&str=r#"
+    local.get $px local.get $timing f64.load f32.demote_f64 f32.store
+    local.get $px local.get $timing f64.load offset=8 f32.demote_f64 f32.store offset=4
+    local.get $px local.get $timing f64.load offset=16 f32.demote_f64 f32.store offset=8
+    local.get $px local.get $timing f64.load offset=24 f32.demote_f64 f32.store offset=12
+"#;
+fn run(body:&str,fps:f64,times:Option<[f64;3]>)->(Result<(),String>,Vec<[f32;4]>) {
+    let plugin=WasmPlugin::new(module(body).as_bytes(),"original-timing").unwrap();
+    let params=Params{values:[("gain".into(),Value::Scalar(1.))].into()};
+    let ctx=EffectCtx{params:&params,time:0.75,layer_size:[8.,4.],seed:0,adjustment:false,
+        env:EffectEnv{frame_rate:fps,layer_frame_times:times,..Default::default()}};
+    let mut pixels=vec![[0.25,0.5,0.75,1.];2];
+    let flat=[1.];
+    let manifest=plugin.manifest();
+    let mut frame=PluginFrame{width:2,height:1,pixels:&mut pixels,scale:0.5};
+    let result=plugin.render_with_context(&mut frame,&PluginParams{manifest,flat:&flat},&ctx,[0.,0.]);
+    (result,pixels)
+}
+#[test] fn exact_timing_comes_from_context(){let (r,p)=run(TIMING,25.,Some([0.3,1.3,0.04]));assert!(r.is_ok(),"{r:?}");assert_eq!(p[0],[25.,0.3,1.3,0.04]);}
+#[test] fn reversed_and_single_frame_bounds_are_preserved(){
+    for times in [[1.3,0.3,0.04],[0.3,0.3,0.04]]{let (r,p)=run(TIMING,25.,Some(times));assert!(r.is_ok());assert_eq!(p[0],[25.,times[0] as f32,times[1] as f32,0.04]);}
+}
+#[test] fn invalid_timing_does_not_enter_wasm_or_modify_pixels(){
+    for (fps,times) in [(0.,Some([0.,1.,0.04])),(f64::NAN,Some([0.,1.,0.04])),(25.,None),(25.,Some([f64::NAN,1.,0.04])),(25.,Some([0.,1.,0.])),(25.,Some([0.,1e10,0.04]))] {
+        let (r,p)=run(TIMING,fps,times);assert!(r.is_err());assert_eq!(p,vec![[0.25,0.5,0.75,1.];2]);
+    }
+}
+#[test] fn trap_and_nonfinite_output_roll_back(){
+    for body in ["local.get $px f32.const 123 f32.store unreachable", "local.get $px f32.const nan f32.store"] {
+        let (r,p)=run(body,25.,Some([0.,1.,0.04]));assert!(r.is_err());assert_eq!(p,vec![[0.25,0.5,0.75,1.];2]);
+    }
+}
+#[test] fn wrong_v3_export_signature_is_refused(){let wat=module("").replace("(param $timing i32)","(param $timing f64)");assert!(WasmPlugin::new(wat.as_bytes(),"bad-signature").is_err());}
+#[test] fn api3_manifest_export_mismatch_is_refused(){let wat=module(TIMING).replace("api\\\":3","api\\\":2");assert!(WasmPlugin::new(wat.as_bytes(),"bad-manifest").is_err());}

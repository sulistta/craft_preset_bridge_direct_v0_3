+#[test]
+fn descriptor_preserves_geometry_and_declaration_index() {
+    fn check(offset: usize, expected: &str, ty: &str) -> String {
+        format!("local.get $table {ty}.load offset={offset} {ty}.const {expected} {ty}.ne if unreachable end\n")
+    }
+    let mut body = String::new();
+    for (offset, value) in [
+        (0, "-1"),
+        (4, "0"),
+        (8, "0"),
+        (12, "1"),
+        (20, "2"),
+        (24, "1"),
+        (28, "0"),
+        (80, "1"),
+        (84, "17"),
+        (88, "2097152"),
+        (92, "2"),
+        (100, "3"),
+        (104, "2"),
+        (108, "0"),
+    ] {
+        body += &check(offset, value, "i32");
+    }
+    for (offset, value) in [(32, "2.5"), (40, "-4"), (48, "0.25"), (56, "8"), (64, "4"), (112, "-3.5"), (120, "7.25"), (128, "0.5"), (136, "20"), (144, "10")] {
+        body += &check(offset, value, "f64");
+    }
+    body += "local.get $np i32.const 7 i32.ne if unreachable end local.get $nt i32.const 2 i32.ne if unreachable end\n";
+    body += "local.get $px local.get $table i32.load offset=16 i32.ne if unreachable end\n";
+    body += "local.get $params f64.load offset=8 f64.const 17 f64.ne if unreachable end\n";
+    body += "local.get $params f64.load offset=16 f64.const 2097152 f64.ne if unreachable end\n";
+    body += "local.get $time f64.const 0.75 f64.ne if unreachable end\n";
+    let mut h = host();
+    h.image.as_mut().unwrap().buf.img = Image::filled(3, 2, [0.1; 4]);
+    run(&load(&body), &params(Some((1 << 53) + 17)), Some(&h)).0.unwrap();
+}

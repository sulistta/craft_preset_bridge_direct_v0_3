+#[test]
+fn explicit_unbound_is_distinct_from_missing_bound_resource() {
+    let body = "local.get $table i32.load offset=92 i32.eqz if else unreachable end local.get $px f32.const 0.1 f32.store";
+    let (result, pixels) = run(&load(body), &params(None), None);
